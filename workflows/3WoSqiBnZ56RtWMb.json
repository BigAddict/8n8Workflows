        "message": "=<!DOCTYPE html>\n<html>\n  <head>\n    <meta charset=\"UTF-8\">\n    <title>Thank You for Contacting Binary Craft Technologies</title>\n  </head>\n  <body style=\"margin:0; padding:0; background-color:#181818; font-family:Arial, sans-serif; color:#ffffff;\">\n    <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" style=\"background-color:#222222; border-collapse:collapse; border-radius:10px; overflow:hidden;\">\n      <tr>\n        <td align=\"center\" style=\"padding: 20px; border-bottom: 2px solid #00aaff;\">\n          <h1 style=\"margin: 0; font-size: 24px; color: #00aaff;\">Binary Craft Technologies</h1>\n          <p style=\"margin: 5px 0; color: #ffffff;\">Innovating with Intelligence</p>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding: 20px; color: #ffffff;\">\n          <p style=\"margin: 0 0 10px;\">Dear {{ $('Webhook').item.json.body.name }},</p>\n          <p style=\"margin: 0 0 10px;\">Thank you for reaching out to <strong>Binary Craft Technologies</strong>. We have received your inquiry and our team will get back to you shortly.</p>\n          <p style=\"margin: 0 0 10px;\">We specialize in:</p>\n          <ul style=\"padding-left: 20px; margin: 0 0 10px;\">\n            <li style=\"margin-bottom: 5px;\">AI-Powered Automation & Workflows</li>\n            <li style=\"margin-bottom: 5px;\">Custom Software Development (Web & Desktop)</li>\n            <li style=\"margin-bottom: 5px;\">Business Management Solutions</li>\n            <li style=\"margin-bottom: 5px;\">API & Plugin Development</li>\n            <li style=\"margin-bottom: 5px;\">Cloud Deployment & Domain Services</li>\n          </ul>\n          <p style=\"margin: 0 0 20px;\">If you have any urgent inquiries, feel free to contact us at <a href=\"mailto:davidnjihia536@gmail.com\" style=\"color: #00aaff; text-decoration: none;\">davidnjihia536@gmail.com</a>.</p>\n          <div style=\"text-align:center; margin: 30px 0;\">\n            <a href=\"https://bigaddict.shop\" style=\"background-color:#00aaff; color:#ffffff; text-decoration:none; padding:12px 20px; border-radius:5px; font-size:16px; display:inline-block;\">Explore Our Services</a>\n          </div>\n        </td>\n      </tr>\n      <tr>\n        <td align=\"center\" style=\"padding: 10px; font-size: 12px; color: #aaaaaa;\">\n          <p style=\"margin: 0;\">\n            Follow us on <a href=\"https://linkedin.com/in/bigaddict\" style=\"color:#00aaff; text-decoration:none;\">LinkedIn</a> |\n            <a href=\"https://github.com/BigAddict\" style=\"color:#00aaff; text-decoration:none;\">GitHub</a>\n          </p>\n          <p style=\"margin: 5px 0;\">©2025 Binary Craft Technologies. All rights reserved.</p>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>",
